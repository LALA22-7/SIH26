# ─────────────────────────────────────────────────────
# CycloneWatch — root .gitignore
# ─────────────────────────────────────────────────────

# ── OS ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.env
.env.prod
.env.local
pip-log.txt
pip-delete-this-directory.txt

# ── Pytest / coverage ─────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml

# ── Jupyter ───────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Node / Frontend ───────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
.yarn/cache
.yarn/unplugged
.next/
out/
.nuxt/
dist/

# ── IDEs ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── Data — raw downloads (large, not for version control) ──
data/raw/
data/normalized/
data/demo/

# ── ML model checkpoints and large binaries ───────────
ml/checkpoints/
*.pt
*.pth
*.ckpt
*.h5
*.pkl
*.joblib

# ── Satellite image files ─────────────────────────────
*.tif
*.tiff
*.nc
*.npz
*.npy
*.hdf5
*.h5

# ── Logs and reports ──────────────────────────────────
*.log
reports/
logs/

# ── Secrets ───────────────────────────────────────────
*.pem
*.key
secrets/
credentials.json

# ── Docker ────────────────────────────────────────────
.docker/

# ── Alembic auto-generated ────────────────────────────
# (keep versions/ tracked, ignore generated cache)
alembic/__pycache__/

# ── Ground truth CSVs generated by split_ibtracs.py ──
# The raw ibtracs file is tracked; per-event splits are generated locally.
# Comment this out if you want to track the split CSVs in the repo.
# data/ground_truth/biparjoy_2023_best_track.csv
# data/ground_truth/amphan_2020_best_track.csv

# ── Training manifest (generated by validate_and_join.py) ─
data/training_manifest.csv
data/metadata.csv
data/normalized/normalized_manifest.csv
data/raw/download_manifest.csv
