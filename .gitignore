# ─────────────────────────────────────────────────────
# CycloneWatch — root .gitignore
# ─────────────────────────────────────────────────────

# ── OS ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.env
.env.prod
.env.local
pip-log.txt
pip-delete-this-directory.txt

# ── Pytest / coverage ─────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml

# ── Jupyter ───────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Node / Frontend ───────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
.yarn/cache
.yarn/unplugged
.next/
out/
.nuxt/
dist/

# ── IDEs ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── Data — raw downloads (large, not for version control) ──
data/raw/
data/demo/
# Normalized frames: the original 2-event dataset (biparjoy_2023, amphan_2020)
# is tracked (17 MB). The extended 5-event dataset is reproduced by running
# the data pipeline scripts. Track only if repo size allows.
data/normalized/fani_2019/
data/normalized/tauktae_2021/
data/normalized/phailin_2013/
data/normalized/hudhud_2014/
data/normalized/ockhi_2017/

# ── ML model checkpoints ──────────────────────────────
# The trained checkpoint is tracked (4 MB). Large future checkpoints should
# use Git LFS. Raw *.pt files elsewhere are ignored.
!ml/checkpoints/model.pt
ml/checkpoints/*.pt.bak
ml/checkpoints/tmp_*

# ── Satellite image files ─────────────────────────────
# Raw .tif/.nc are large and not tracked.
# .npz frames in data/normalized/ ARE tracked (see above).
*.tif
*.tiff
*.nc
*.npy
*.hdf5
*.h5
# *.npz  ← intentionally NOT ignored (normalized frames tracked)

# ── Logs and reports ──────────────────────────────────
*.log
reports/
logs/

# ── Secrets ───────────────────────────────────────────
*.pem
*.key
secrets/
credentials.json

# ── Docker ────────────────────────────────────────────
.docker/

# ── Alembic auto-generated ────────────────────────────
# (keep versions/ tracked, ignore generated cache)
alembic/__pycache__/

# ── Ground truth CSVs generated by split_ibtracs.py ──
# The raw ibtracs file is tracked; per-event splits are generated locally.
# Comment this out if you want to track the split CSVs in the repo.
# data/ground_truth/biparjoy_2023_best_track.csv
# data/ground_truth/amphan_2020_best_track.csv

# ── Training manifests (generated by data pipeline, but tracked for reproducibility) ─
# Small CSVs (<30 KB each). Un-comment to stop tracking if they grow large.
# data/training_manifest.csv
# data/metadata.csv
# data/normalized/normalized_manifest.csv
data/raw/download_manifest.csv
