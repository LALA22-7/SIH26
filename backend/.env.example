# ─────────────────────────────────────────────────────────────
# CycloneWatch Backend — Environment Variables
# Copy to .env and fill in values before running docker compose
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=cyclone
POSTGRES_PASSWORD=cyclone_secret
POSTGRES_DB=cyclonewatch

# ── Database URLs (auto-set by docker-compose, override if needed)
DATABASE_URL=postgresql+asyncpg://cyclone:cyclone_secret@db:5432/cyclonewatch
DATABASE_SYNC_URL=postgresql+psycopg2://cyclone:cyclone_secret@db:5432/cyclonewatch

# ── Application ──────────────────────────────────────────────
DEBUG=true
API_VERSION=v1

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Use "*" for dev. Restrict in prod.
CORS_ORIGINS=*

# ── Data paths (inside container) ────────────────────────────
DATA_ROOT=/data
DEMO_DATA_ROOT=/data/demo

# ── ML ───────────────────────────────────────────────────────
# Path to the ml package inside the container (set via PYTHONPATH in docker-compose)
ML_PACKAGE_PATH=/ml

# ── Stub mode ────────────────────────────────────────────────
# Force stub mode even if ml package is importable
ML_FORCE_STUB=false
